# name: test/sql/basic.test
# description: explain_pattern and a minimal match.
# group: [sql]

require-env VGI_MATCHRECOGNIZE_WORKER

statement ok
ATTACH 'mr' AS mr (TYPE vgi, LOCATION '${VGI_MATCHRECOGNIZE_WORKER}');

query T
SELECT mr.main.explain_pattern('START DOWN+ UP+');
----
START · (DOWN)+greedy · (UP)+greedy

query T
SELECT mr.main.explain_pattern('A+? (B | C)');
----
(A)+reluctant · (B | C)
